APP_NAME=SiPrega
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://DOMAIN-ATAU-IP-RESMI-BALMON
APP_TIMEZONE=Asia/Jakarta
WHATSAPP_ADMIN_NUMBER=

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Host tanpa skema dan port. Pisahkan dengan koma jika lebih dari satu.
TRUSTED_HOSTS=DOMAIN-ATAU-IP-RESMI-BALMON
# Kosongkan jika tidak ada reverse proxy. Jangan gunakan wildcard (*).
TRUSTED_PROXIES=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# WAJIB database production. Jangan gunakan "absensi_pegawai" karena itu database demo/development.
DB_DATABASE=absensi_pegawai_prod
DB_USERNAME=USER_DATABASE_KHUSUS_APLIKASI
DB_PASSWORD=PASSWORD_DATABASE_YANG_KUAT

BROADCAST_DRIVER=log
CACHE_DRIVER=file
CACHE_PREFIX=siprega_prod_cache
QUEUE_CONNECTION=sync
FILESYSTEM_DRIVER=local
SESSION_DRIVER=file
SESSION_COOKIE=siprega_session
SESSION_LIFETIME=60
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
AUTH_REMEMBER_DURATION=10080

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
